{%- assign group_by = vars.group_by | default: "kind" %}
{%- assign live_filters = data.filters | where_exp: "f", "f.deprecated != true" %}
{%- if group_by == "source" %}
{%-   assign sort_by = "kind"  %}
{%- elsif  group_by == "kind" %}
{%-   assign sort_by = "source"  %}
{%- endif %}
{%- assign grouped_filters = live_filters | group_by: group_by | sort: sort_by %}
{%- for set in grouped_filters %}
{%-   assign section_key = set.key | default: set.name | slugify %}
{%-   if group_by == "source" %}
{%-     assign section_name =  data.sources[set.name].name | default: set.name %}
{%-     assign section_title = "Filters from " | append: section_name %}
{%-   else %}
{%-     assign section_title = set.name | replace: '-', ' ' | capitalize | append: " Filters" %}
{%-   endif %}
:example-capition!:
:toc: macro

ifdef::env-github[]
toc::[]
endif::env-github[]

[[{{ section_key }}]]
== {{ section_title }}

// tag::{{ section_key }}[]
{%-   for filter in set.items %}
[[filter__{{ filter.key }},{{ filter.name }}]]
{{ filter.name }} (`{{ filter.key }}`)::
+
--
{{ filter.description }}
{%-     if group_by != "source" %}

[horizontal]
Source::: {{ data.sources[filter.source].name | default: filter.source }}
{%-     endif %}
{%-     if group_by != "kind" %}
{%-       assign category = data.kinds | where: "key", filter.kind | first %}

[horizontal]
Category::: {{ category.name | default: filter.kind }}
{%-     endif %}
{%-     if filter.examples %}

[vertical]
Examples:::
+
{%-       for example in filter.examples %}
{%-         if example.description %}
.{{ example.description }}
{%-         endif %}
====
{%-         if example.input %}
.Input
[source,liquid]
----
{{ example.input }}
----
{%-         endif %}
{%-         if example.output %}

.Output
[source,liquid]
----
{{ example.output }}
----
{%-         endif %}
====
{%-         unless forloop.last %}
+
{%-         endunless %}
{%-       endfor %}
{%-     endif %}
--
{%-   endfor %}
// end::{{ section_key }}[]
{% endfor %}